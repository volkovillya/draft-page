# Copy to .env.local and fill in. Never commit real values.
DRAFTPAGE_DATABASE_URL=postgres://draftpage:draftpage-local@localhost:5440/draftpage
# false | require | verify-full (use verify-full for RDS)
DRAFTPAGE_DATABASE_SSL=false
# On AWS, instead of the URL: DRAFTPAGE_DB_HOST, DRAFTPAGE_DB_PORT, DRAFTPAGE_DB_NAME,
# DRAFTPAGE_DB_USER, DRAFTPAGE_DB_PASSWORD (user and password come from the RDS-managed secret).

# Auth0 (names required by @auth0/nextjs-auth0 v4)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:6500

# Optional, dev server only: sign in as a local fake user without Auth0.
# DRAFTPAGE_DEV_AUTH=on
