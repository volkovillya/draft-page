# Copy to .env.local and fill in. Never commit real values.
DRAFTPAGE_DATABASE_URL=postgres://draftpage:draftpage-local@localhost:5440/draftpage
# false | require | verify-full (use verify-full for RDS)
DRAFTPAGE_DATABASE_SSL=false
# On AWS, instead of the URL: DRAFTPAGE_DB_HOST, DRAFTPAGE_DB_PORT, DRAFTPAGE_DB_NAME,
# DRAFTPAGE_DB_USER, DRAFTPAGE_DB_PASSWORD (user and password come from the RDS-managed secret).

# Auth0 (names required by @auth0/nextjs-auth0 v4)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:6500

# Optional, dev server only: sign in as a local fake user without Auth0.
# DRAFTPAGE_DEV_AUTH=on

# AI jobs (Phase 3). Local development: run jobs inside the dev server with the pretend AI.
DRAFTPAGE_AI_LOCAL_WORKER=on
DRAFTPAGE_AI_LOCAL_WORKER_URL=http://localhost:6500
# Only callers signed as this IAM role may use /api/internal/*. Locally any role-shaped ARN works.
DRAFTPAGE_WORKER_ROLE_ARN=arn:aws:iam::000000000000:role/draftpage-ai-worker-local
# fake (default) | bedrock. With bedrock also set DRAFTPAGE_AI_MODEL_ID (and DRAFTPAGE_AI_REGION).
DRAFTPAGE_AI_EDITOR=fake
# Pretend thinking time for the fake editor, so the "Working…" state is visible.
DRAFTPAGE_AI_FAKE_DELAY_MS=3000
# How many @Claude edits may start in any 24 hours, per person and for everyone together (0 = off).
# DRAFTPAGE_AI_LIMIT_PER_MEMBER=10
# DRAFTPAGE_AI_LIMIT_TOTAL=30
# What @Claude edits may cost per calendar month (UTC), in dollars. Needs DRAFTPAGE_AI_EDITOR and
# DRAFTPAGE_AI_MODEL_ID to price each edit's worst case; the fake editor is free.
# DRAFTPAGE_AI_MONTHLY_BUDGET_USD=5
# On AWS instead of the local worker: DRAFTPAGE_AI_QUEUE_URL (the SQS queue the relay publishes to).
