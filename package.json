{
  "name": "draftpage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "next dev -p 6500",
    "build": "next build",
    "build:worker": "bash scripts/build-worker.sh",
    "start": "next start -p 6500",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "bash scripts/test-db.sh",
    "test:db:stop": "docker rm -f draftpage-test-pg",
    "test:e2e": "playwright test",
    "test:image": "bash scripts/test-image.sh",
    "aws:deploy": "bash scripts/aws-deploy.sh",
    "aws:migrate": "bash scripts/aws-migrate.sh",
    "aws:pause": "bash scripts/aws-pause.sh",
    "aws:resume": "bash scripts/aws-resume.sh",
    "aws:db-tunnel": "bash scripts/aws-db-tunnel.sh"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.30.0",
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-bedrock-runtime": "3.1140.0",
    "@aws-sdk/client-sqs": "3.1140.0",
    "@aws-sdk/rds-signer": "3.1140.0",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.3",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/aws-lambda": "8.10.163",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
